    std::cin >> V;
    std::cout << "Введите S: ";    
    std::cin >> S;
    std::cout << "Введите C: ";    
    std::cin >> C;
    std::cout << "Введите C2: ";    
    std::cin >> C2;

    L = po*V*V*S*C/2;
    std::cout << "Подъёмная сила: "<< L << std::endl;


    float result = add(po, V, C2, S); // Вызов функции
    std::cout << "Аэродинамическое сопротивление: " << result;

    
    return 0;
}
